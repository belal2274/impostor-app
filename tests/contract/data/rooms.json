{
  "_doc": "Room cases. Edit data to add cases; the tests iterate over it.",
  "hostSettings": [
    {
      "name": "defaults when omitted",
      "send": {},
      "expect": {
        "rounds": 3,
        "dur": 180
      }
    },
    {
      "name": "below minimum",
      "send": {
        "rounds": -1,
        "dur": 59
      },
      "expect": {
        "rounds": 1,
        "dur": 60
      }
    },
    {
      "name": "at minimum",
      "send": {
        "rounds": 1,
        "dur": 60
      },
      "expect": {
        "rounds": 1,
        "dur": 60
      }
    },
    {
      "name": "at maximum",
      "send": {
        "rounds": 20,
        "dur": 900
      },
      "expect": {
        "rounds": 20,
        "dur": 900
      }
    },
    {
      "name": "above maximum",
      "send": {
        "rounds": 21,
        "dur": 901
      },
      "expect": {
        "rounds": 20,
        "dur": 900
      }
    },
    {
      "name": "non-integers are floored",
      "send": {
        "rounds": 2.9,
        "dur": 90.9
      },
      "expect": {
        "rounds": 2,
        "dur": 90
      }
    },
    {
      "name": "non-numeric falls back to defaults",
      "send": {
        "rounds": "x",
        "dur": "y"
      },
      "expect": {
        "rounds": 3,
        "dur": 180
      }
    },
    {
      "name": "rounds 0 clamps to 1",
      "send": {
        "rounds": 0
      },
      "expect": {
        "rounds": 1,
        "dur": 180
      }
    },
    {
      "name": "dur 0 clamps to 60",
      "send": {
        "dur": 0
      },
      "expect": {
        "rounds": 3,
        "dur": 60
      }
    }
  ],
